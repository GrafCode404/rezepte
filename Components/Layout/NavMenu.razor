@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Rezepte</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Rezepte
            </NavLink>
        </div>

        @if (showNewRecipe)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="neu">
                    <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Neues Rezept
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="papierkorb">
                    <span class="bi bi-trash-fill" aria-hidden="true"></span> Papierkorb
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="uebersicht">
                <span class="bi bi-clipboard-check-fill" aria-hidden="true"></span> Übersicht
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="zugang">
                <span class="bi bi-person-fill" aria-hidden="true"></span> Zugang
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notizen">
                <span class="bi bi-chat-dots-fill" aria-hidden="true"></span> Anmerkungen
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool showNewRecipe;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            showNewRecipe = await JS.InvokeAsync<bool>("RecipeEdit.isLoggedIn");
            StateHasChanged();
        }
    }
}