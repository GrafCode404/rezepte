@page "/neu"
@using Markdig
@using RezepteWeb.Models
@using RezepteWeb.Services
@inject RecipeService RecipeService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Neues Rezept – Rezepte</PageTitle>

<nav aria-label="breadcrumb">
    <a href="./" class="breadcrumb-link text-muted">&larr; Zur Übersicht</a>
</nav>

<h1>Neues Rezept</h1>

<p class="text-muted">Zum Speichern ist ein Login über <a href="zugang">Zugang</a> nötig.</p>

<div class="recipe-editor">
    <div class="recipe-editor-pane">
        <label class="form-label" for="editor-markdown">Markdown</label>
        <textarea id="editor-markdown" class="form-control recipe-editor-textarea"
                  @bind="markdown" @bind:event="oninput"></textarea>
    </div>
    <div class="recipe-editor-pane">
        <label class="form-label">Vorschau</label>
        <div class="recipe-content recipe-editor-preview">
            @((MarkupString)Preview)
        </div>
    </div>
</div>

<div class="recipe-editor-actions mt-3">
    <button type="button" class="btn btn-primary" @onclick="Save" disabled="@saving">
        @(saving ? "Speichert …" : "Speichern")
    </button>
    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@saving">Abbrechen</button>
</div>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private string markdown = Template;
    private string? error;
    private bool saving;

    private static readonly string Template = string.Join('\n', new[]
    {
        "# [Rezeptname]",
        "",
        "* **Menge:** [z. B. 1 Laib]",
        "* **Vorteig:** -",
        "* **Stockgare:** [z. B. 2 - 3 Std.]",
        "* **Stückgare:** [z. B. 40 Minuten]",
        "* **Backdauer:** [z. B. 30 - 40 Minuten]",
        "* **Backtemperatur:** [z. B. 180 °C Umluft]",
        "",
        "<br />",
        "",
        "| Zutaten                 | 1x    | 2x    |",
        "| :---                    | :---  | :---  |",
        "| **Abschnitt**           |       |       |",
        "| Zutat                   | Menge | Menge |",
        "",
        "<div class=\"page\"/>",
        "",
        "## **Anleitungen**",
        "",
        "### **Schritt 1**",
        "- Anleitungsschritt.",
    });

    private string Preview =>
        Markdown.ToHtml(markdown.Replace("<div class=\"page\"/>", string.Empty, StringComparison.OrdinalIgnoreCase),
            RecipeService.CreatePipeline());

    private static string ExtractTitle(string md)
    {
        var line = md.Split('\n').FirstOrDefault(l => l.TrimStart().StartsWith("# "));
        return line is null ? "Rezept" : line.TrimStart()[2..].Trim();
    }

    private async Task Save()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        error = null;

        var title = ExtractTitle(markdown);
        if (title == "[Rezeptname]" || string.IsNullOrWhiteSpace(title))
        {
            error = "Bitte zuerst den Titel (# Überschrift) setzen.";
            saving = false;
            return;
        }

        var result = await JS.InvokeAsync<EditResult>("RecipeEdit.save", new
        {
            fileName = (string?)null,
            markdown = markdown,
            title = title
        });

        if (result.Ok)
        {
            RecipeService.Reset();
            NavigationManager.NavigateTo($"/rezepte/{Slugify(title)}");
        }
        else
        {
            error = result.Error ?? "Speichern fehlgeschlagen.";
            saving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/");
    }

    private static string Slugify(string title)
    {
        var normalized = title
            .ToLowerInvariant()
            .Replace("ä", "ae")
            .Replace("ö", "oe")
            .Replace("ü", "ue")
            .Replace("ß", "ss");

        var slug = new System.Text.StringBuilder(normalized.Length);
        var lastWasDash = false;
        foreach (var c in normalized)
        {
            if (char.IsAsciiLetterOrDigit(c))
            {
                slug.Append(c);
                lastWasDash = false;
            }
            else if (!lastWasDash)
            {
                slug.Append('-');
                lastWasDash = true;
            }
        }

        return slug.ToString().Trim('-');
    }
}
