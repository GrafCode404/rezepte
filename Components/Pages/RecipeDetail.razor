@page "/rezepte/{Slug}"
@page "/{Slug}"
@using Net.Codecrete.QrCodeGenerator
@using RezepteWeb.Models
@using RezepteWeb.Services
@inject IJSRuntime JS
@inject RecipeService RecipeService
@inject NavigationManager NavigationManager

@if (recipe is null)
{
    <PageTitle>Rezept nicht gefunden</PageTitle>
    <h1>Rezept nicht gefunden</h1>
    <p class="text-muted">Das gesuchte Rezept existiert nicht.</p>
    <a href="./" class="btn btn-primary">Zur Übersicht</a>
}
else
{
    <PageTitle>@recipe.Title – Rezepte</PageTitle>

    <nav aria-label="breadcrumb">
        <a href="./" class="breadcrumb-link text-muted">&larr; Zur Übersicht</a>
    </nav>

    <h1>@recipe.Title</h1>

    @if (recipe.Facts.Count > 0)
    {
        <ul class="list-inline recipe-facts">
            @foreach (var fact in recipe.Facts)
            {
                <li class="list-inline-item">
                    <span class="badge text-bg-light border"><strong>@fact.Key:</strong> @fact.Value</span>
                </li>
            }
        </ul>
    }

    <div class="recipe-content">
        @((MarkupString)recipe.Html)
    </div>

    <section class="recipe-comments" aria-label="Kommentare">
        <h2>Kommentare &amp; Anmerkungen</h2>
        <p class="text-muted">Beim Backen etwas aufgefallen?</p>
        <div id="recipe-notes"></div>
    </section>

    @if (qrSvg is not null)
    {
        <section class="recipe-share" aria-label="Teilen">
            <h3>Teilen</h3>
            <div class="share-buttons">
                <a class="btn btn-share" href="@waLink" target="_blank" rel="noopener">WhatsApp</a>
                <a class="btn btn-share" href="@mailLink">E-Mail</a>
                <button type="button" class="btn btn-share" id="share-copy" @onclick="CopyLink">Link kopieren</button>
                <button type="button" class="btn btn-share" @onclick="ToggleQr">QR-Code</button>
            </div>
            @if (showQr)
            {
                <figure class="recipe-qr recipe-qr-large">
                    @((MarkupString)qrSvg)
                    <figcaption>Link als QR-Code</figcaption>
                </figure>
            }
        </section>
    }
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private RezepteWeb.Models.Recipe? recipe;
    private string? qrSvg;
    private string waLink = "";
    private string mailLink = "";
    private bool showQr;

    private void ToggleQr() => showQr = !showQr;

    protected override async Task OnParametersSetAsync()
    {
        recipe = await RecipeService.GetBySlugAsync(Slug ?? string.Empty);

        if (recipe is not null)
        {
            var url = NavigationManager.Uri;
            qrSvg = QrCode.EncodeText(url, QrCode.Ecc.Medium).ToSvgString(2);
            waLink = "https://wa.me/?text=" + Uri.EscapeDataString(recipe.Title + " – " + url);
            mailLink = "mailto:?subject=" + Uri.EscapeDataString(recipe.Title) +
                "&body=" + Uri.EscapeDataString(url);
        }
    }

    private async Task CopyLink()
    {
        if (recipe is not null)
        {
            await JS.InvokeVoidAsync("RecipeShare.copy", NavigationManager.Uri);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (recipe is not null)
        {
            await JS.InvokeVoidAsync("RecipeNotes.init", Slug, recipe.Title);
        }
    }
}